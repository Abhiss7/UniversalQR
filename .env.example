# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=universalqr
POSTGRES_PASSWORD=universalqr_dev_password
POSTGRES_DB=universalqr_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full connection URL used by Prisma
DATABASE_URL="postgresql://universalqr:universalqr_dev_password@localhost:5432/universalqr_db?schema=public"

# ─── Backend (NestJS) ────────────────────────────────────────────────────────
BACKEND_PORT=3001
NODE_ENV=development

# JWT — replace with a long random secret in production
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=UniversalQR

# ─── QR Storage (local for development) ──────────────────────────────────────
QR_STORAGE_PATH=./uploads/qr-codes
QR_PUBLIC_URL=http://localhost:3001/uploads/qr-codes
